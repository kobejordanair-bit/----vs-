[
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "一飯斗米，肉十斤，被甲上馬，以示尚可用"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "廉將軍雖老，尚善飯，然與臣坐，頃之三遺矢矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "以爲老，遂不召"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "我思用趙人"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "勇氣聞於諸侯"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "趙之良將也"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "爲趙將伐齊，大破之，取陽晉，拜爲上卿，以勇氣聞於諸侯"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "彊秦之所以不敢加兵於趙者，徒以吾兩人在也"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "使樂乘代廉頗"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "趙前後所亡凡四十五萬"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "趙壯者盡於長平，其孤未壯"
 },
 {
  "book": "shiji",
  "title": "史記/卷102",
  "quote": "吾獨不得廉頗、李牧時爲吾將，吾豈憂匈奴哉"
 },
 {
  "book": "shiji",
  "title": "史記/卷102",
  "quote": "陛下雖得廉頗、李牧，弗能用也"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "東攻齊，破其一軍"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "復伐齊幾，拔之"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "攻魏之防陵、安陽，拔之"
 },
 {
  "book": "shiji",
  "title": "史記/卷043",
  "quote": "攻魏房子，拔之，因城而還。又攻安陽，取之"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "陷趙軍，取二鄣四尉"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "堅壁以待秦，秦數挑戰，趙兵不出"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "趙王數以為讓"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "廉頗易與，且降矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "既怒廉頗軍多失亡，軍數敗，又反堅壁不敢戰"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "悉更約束，易置軍吏"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "王以名使括，若膠柱而鼓瑟耳"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "縱奇兵，詳敗走，而絶其糧道"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "大破燕軍於鄗，殺栗腹，遂圍燕。燕割五城請和"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "伐魏之繁陽，拔之"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "士卒犯秦斥兵"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "怒，攻樂乘，樂乘走"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "奔魏之大梁"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "魏不能信用"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "一爲楚將，無功"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "道遠險狹，難救"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "兩鼠鬥於穴中，將勇者勝"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "破秦軍閼與下"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "我爲趙將，有攻城野戰之大功，而藺相如徒以口舌爲勞，而位居我上，且相如素賤人，吾羞，不忍爲之下"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "我見相如，必辱之"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "先國家之急而後私讎"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "肉袒負荊，因賓客至藺相如門謝罪"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "鄙賤之人，不知將軍寬之至此也"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "卒相與驩，爲刎頸之交"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "天下以市道交，君有勢，我則從君，君無勢則去，此固其理也，有何怨乎"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "三十日不還，則請立太子爲王"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "堅壁以待秦"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "數挑戰，趙兵不出"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "趙軍士卒犯秦斥兵"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "以勇氣聞於諸侯"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "有攻城野戰之大功"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "王不行，示趙弱且怯也"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "郭開多與使者金，令毀之"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "趙王思復得廉頗"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "失勢之時，故客盡去"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "吾羞，不忍爲之下"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "怒，攻樂乘"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "我爲趙將，有攻城野戰之大功"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "思復用於趙"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "陰使人迎之"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "徒以口舌爲勞，而位居我上"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "拔武遂、方城"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "君有勢，我則從君，君無勢則去"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "一飯斗米，肉十斤，被甲上馬"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "以尉文封廉頗爲信平君"
 },
 {
  "book": "shiji",
  "title": "史記/卷073",
  "quote": "堅壁不敢戰"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "一飯斗米，肉十斤"
 },
 {
  "book": "shiji",
  "title": "史記/卷081",
  "quote": "卒死於壽春"
 }
]