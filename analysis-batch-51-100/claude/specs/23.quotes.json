[
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "陛下以功擢臣，不問門地，臣所以有今日，由此涅爾，臣願留以勸軍中，不敢奉詔"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "偏將屢為賊敗，士卒多畏怯"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "行常為先鋒"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "廣源州蠻儂智高反，陷邕州，又破沿江九州，圍廣州，嶺外騷動"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "仁宗猶以為憂"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "起健卒至政府，隱然為時名將，惟青與逵兩人爾"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "前後大小二十五戰，中流矢者八"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "燔積聚數萬"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "被創甚，聞寇至，即挺起馳赴，眾爭前為用"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "被發、帶銅面具，出入賊中，皆披靡莫敢當"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "此良將材也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "將不知古今，匹夫勇爾"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "折節讀書，悉通秦、漢以來將帥兵法"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "皆扼賊要害"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "皆輕敵敗死，軍聲大沮"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "毋妄與賊鬥，聽吾所為"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "潰於崑崙關"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "令之不齊，兵所以敗"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "驅出軍門斬之"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "沔、靖相顧愕眙，諸將股慄"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "令軍中休十日"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "整軍騎，一晝夜絕昆侖關，出歸仁鋪為陣"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "賊氣銳甚，沔等懼失色"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "執白旗麾騎兵，縱左右翼，出賊不意，大敗之，追奔五十里，斬首數千級"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "安知非詐邪？寧失智高，不敢誣朝廷以貪功也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "假兵於外以除內寇，非我利也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "人服其有遠略"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "在邊境凡二十五戰，無大勝，亦無大敗，最後崑崙一舉，頗著奇雋"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "每出，士卒輒指目以相矜誇"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "青家狗生角，且數有光怪"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "避水徙家相國寺，行止殿上，人情頗疑"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "疽發髭，卒"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "為人慎密寡言，其計事必審中機會而後發"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "先正部伍，明賞罰，與士同饑寒勞苦，雖敵猝犯之，無一士敢後先者"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "尤喜推功與將佐"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "悉以諉沔，退若不用意者"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "始歎其勇，既而服其為人，自以為不如也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "悉力賙其家事"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "起行伍而名動夷夏，深沈有智略，能以畏慎保全終始"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "士卒輒指目以相矜誇"
 },
