 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "臣起行伍，非戰伐無以報國"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "願得蕃落騎數百，益以禁兵，羈賊首致闕下"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "陛下以功擢臣，不問門地"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "蠻夷貪得忘義"
 },
 {
  "book": "songshi",
  "title": "宋史/卷290",
  "quote": "蔣偕、張忠皆輕敵敗死，軍聲大沮"
 },
 {
