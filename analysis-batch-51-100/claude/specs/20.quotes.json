[
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "天下奇男子誰也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "將不過萬人，橫行無敵，真奇男子"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "遇春雖人傑，吾得而臣之。吾不能臣王保保，其人奇男子也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "主帥有命，請公留一物為別"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "本王姓，小字保保"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "汝、潁盜起，中原大亂"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "朝廷下詔和解，終不聽"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "太祖已滅陳友諒，盡有江、楚地"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "戰河南、北，擊賊關中、河東，復汴梁，走劉福通，平山東"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "穴地而入，克之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "執豐、士誠，剖其心以祭察罕"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "銜哀以討賊，攻城益急"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "取田豐、王士誠之心以祭其父"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "以萬騎入衛"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "以太子令舉兵討孛羅，入大同，進薄大都"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "當是時，微擴廓，太子幾殆"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "以重兵擁太子入城，脅順帝禪位"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "留其軍，以數騎入朝"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "知其意，比至京城三十里，即散遣其軍"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "由是太子銜之，而順帝亦心忌擴廓"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "吾與若父交，若發未燥，敢檄我耶"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "吾奉詔總天下兵，而鎮將不受節制，何討賊為"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "相持經年，數百戰未能決"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "夜出師薄其營掩擊之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "戰于韓店，明師大敗"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "乘虛搗太原"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "倉卒以十八騎北走"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "盡亡其眾，獨與妻子數人北走，至黃河，得流木以渡，遂奔和林"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "大敗，死者數萬人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "吾用兵未嘗敗北。今諸將自請深入，敗于和林，輕信無謀，致多殺士卒，不可不戒"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "明兵希出塞矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "命諸將嚴為之備"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "廬墓以終喪"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "鹵簿甲仗互數十里，軍容甚盛"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "凡七致書，皆不答"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "數請戰，擴廓帖木兒不應"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "入大同，進薄大都"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "死者數萬人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "得流木以渡"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "諜知貊高分軍掠祁縣，即夜出師薄其營掩擊之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "南軍強，未可輕進"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "分省以自隨，官屬之盛，幾與朝廷等"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "冊其妹為秦王妃"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "輒留使者不遣"
 },
 {
  "book": "yuanshi",
  "title": "元史/卷141",
  "quote": "數請戰，擴廓帖木兒不應，或師出即復退"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "剖其心以祭察罕"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "出不意搗鳳翔，覆思齊巢穴"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "行至衛輝，軍變"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "罪狀擴廓於朝"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "名義所存，不敢輒渝初志"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "鹵簿甲仗互數十里"
 },
 {
  "book": "mingshi",
  "title": "明史/卷124",
  "quote": "微擴廓，太子幾殆"
 }
]