[
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "木猶如此，人何以堪"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "攀枝執條，泫然流涕"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "既不能流芳後世，不足復遺臭萬載邪"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "先立功河朔，還受九錫"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "枕戈泣血，志在復仇"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "刃彪於廬中，並追二弟殺之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "宜委以方召之任"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "五十餘載，先舊徂沒，後來童幼"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "遂望絕於本邦，宴安於所托"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "杖殷浩等以抗己"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "雖有君臣之跡，亦相羈縻而已，八州士眾資調，殆不為國家用"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "以蜀險遠，而溫兵寡少，深入敵場，甚以為憂"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "自將步卒直指成都"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "眾懼欲退，而鼓吏誤鳴進鼓，於是攻之，勢眾大潰"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "面縛輿櫬請命"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "統步騎四萬"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "持牛酒迎溫于路者十八九"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "不圖今日復見官軍"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "芟苗清野，軍糧不屬"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "收三千餘口而還"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "結陣而前，親被甲督弟沖及諸將奮擊"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "謁先帝諸陵，陵被侵毀者皆繕復之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "有司皆奏行之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "播流江表者，請一切北徙，以實河南"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "鑿钜野三百餘里以通舟運"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "不能開石門，軍糧竭盡"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "溫軍敗績，死者三萬人"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "甚恥之，歸罪於真，表廢為庶人"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "築長圍守之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "乞活數百人悉坑之，以妻子為賞"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "溫還軍之後，司、豫、青、兗復陷於賊"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "欲先立功河朔，還受九錫。既逢覆敗，名實頓減，於是參軍郗超進廢立之計，溫乃廢帝而立簡文帝"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "諷朝廷加己九錫，累相催促"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "豪爽有風概，姿貌甚偉"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "孫仲謀、晉宣王之流亞也"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "每燕惟下七奠柈茶果而已"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "自以雄姿風氣是宣帝、劉琨之儔"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "公甚似劉司空"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "褫冠解帶，昏然而睡，不怡者數日"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "豈必諸人之過"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "坐中皆失色"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "伊等不為汝所處分"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "害之無益於沖，更失時望"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "聲言北伐，拜表便行"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "公若作天子，亦當如是"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "死者三萬人"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "司、豫、青、兗復陷於賊"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "親被甲督弟沖及諸將奮擊"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "眼如紫石棱，須作猥毛磔"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "親自陷陣，殺溫將應庭、劉泓"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "此常山蛇勢也"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "自此內外大權一歸溫矣"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "百官皆于南州祖道，都邑盡傾"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "行役既久，又兼疾癘，死者十四五，百姓嗟怨"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "啖芻豆十倍于常牛，負重致遠，曾不若一羸牸"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "王夷甫諸人"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "身非羈旅之賓，跡無韓彭之釁"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "為爾寂寂，將為文景所笑"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "泣下數十行"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "兢懼，不得一言而出"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "安石，卿何事乃爾"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "未有君拜於前，臣揖於後"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "如其不效，臣之罪也，褰裳赴鑊，其甘如薺"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "實恥帝道皇居仄陋于東南，痛神華桑梓遂埋于戎狄"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "恃麥熟，取以為軍資"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "上疏解職，欲送葬宛陵"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "不怡者數日"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "一日一夜頻有四詔"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "便來，便來"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "朽邁疾病，懼不支久"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "依諸葛亮故事，甲仗百人入殿"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "依武侯、王公故事"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "初望簡文臨終禪位於己，不爾便為周公居攝"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "可人，可人"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "王夷甫諸人不得不任其責"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷098",
  "quote": "錫文未及成而薨"
 }
]