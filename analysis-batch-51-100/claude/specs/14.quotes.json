[
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "勒兵向闕，殺王淵及內侍康履以下百餘人"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "遜位於皇子魏國公"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "睿聖仁孝皇帝"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "失馭臣之柄"
 },
 {
  "book": "songshi",
  "title": "宋史/卷029",
  "quote": "賜岳飛死于大理寺，斬其子雲及張憲于市"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "定議航海避兵"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "高宗恭儉仁厚，以之繼體守文則有餘，以之撥亂反正則非其才也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "時危勢逼，兵弱財匱，而事之難處又有甚於數君者"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "四失罪己：一曰昧經邦之大略，二曰昧戡難之遠圖，三曰無綏人之德，四曰失馭臣之柄"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "榜朝堂，遍諭天下，使知朕悔過之意"
 },
 {
  "book": "songshi",
  "title": "宋史/卷026",
  "quote": "岳飛邀擊于靜安鎮，敗之"
 },
 {
  "book": "songshi",
  "title": "宋史/卷026",
  "quote": "屯焦山寺邀擊之"
 },
 {
  "book": "songshi",
  "title": "宋史/卷029",
  "quote": "岳飛乞增兵，不許"
 },
 {
  "book": "songshi",
  "title": "宋史/卷029",
  "quote": "留岳飛行在"
 },
 {
  "book": "songshi",
  "title": "宋史/卷029",
  "quote": "謀據襄陽爲變"
 },
 {
  "book": "songshi",
  "title": "宋史/卷029",
  "quote": "賜岳飛死于大理寺"
 },
 {
  "book": "songshi",
  "title": "宋史/卷030",
  "quote": "藏金國誓書於內侍省"
 },
 {
  "book": "songshi",
  "title": "宋史/卷030",
  "quote": "割商、秦之半畀金國"
 },
 {
  "book": "songshi",
  "title": "宋史/卷030",
  "quote": "以大散關為界"
 },
 {
  "book": "songshi",
  "title": "宋史/卷030",
  "quote": "党援岳飛，不主和議"
 },
 {
  "book": "songshi",
  "title": "宋史/卷030",
  "quote": "士亻褭嘗營護岳飛為朋比"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "罷三招討司"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "詔皇太子即皇帝位"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "崩于德壽殿，年八十一"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "其始惑于汪、黃，其終制於奸檜，恬墮猥懦，坐失事機。甚而趙鼎、張浚相繼竄斥，岳飛父子竟死于大功垂成之秋"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "帝方偷安忍恥，匿怨忘親，卒不免于來世之誚"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "伏兵，執寶等十七人斬之"
 },
 {
  "book": "songshi",
  "title": "宋史/卷029",
  "quote": "乞增兵，不許"
 },
 {
  "book": "songshi",
  "title": "宋史/卷029",
  "quote": "乞奏事行在，不許"
 },
 {
  "book": "songshi",
  "title": "宋史/卷027",
  "quote": "詔有司毀之，奪康國二官"
 },
 {
  "book": "songshi",
  "title": "宋史/卷024",
  "quote": "率兵離相州"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "其終制於奸檜"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "因四方勤王之師"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "一時有志之士，為之扼腕切齒"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "卒不免于來世之誚"
 },
 {
  "book": "songshi",
  "title": "宋史/卷030",
  "quote": "上壽于慈甯宮"
 },
 {
  "book": "songshi",
  "title": "宋史/卷032",
  "quote": "以之繼體守文則有餘，以之撥亂反正則非其才也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷025",
  "quote": "遜位於皇子"
 }
