[
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "今臣將兵三十餘萬，身雖囚系，其勢足以倍畔，然自知必死而守義者，不敢辱先人之教，以不忘先主也"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "我何罪於天，無過而死乎"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "恬罪固當死矣。起臨洮屬之遼東，城塹萬餘里，此其中不能無絕地脈哉？此乃恬之罪也"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "固輕百姓力矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "何乃罪地脈哉"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "自齊事秦昭王，官至上卿"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "攻楚，大破之，殺項燕"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "嘗書獄典文學"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "因家世得為秦將，攻齊，大破之，拜為內史"
 },
 {
  "book": "shiji",
  "title": "史記/卷006",
  "quote": "亡秦者胡也"
 },
 {
  "book": "shiji",
  "title": "史記/卷006",
  "quote": "始皇乃使將軍蒙恬發兵三十萬人北擊胡，略取河南地"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "暴師於外十餘年，居上郡。是時蒙恬威振匈奴"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "位至上卿，出則參乘，入則御前"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "將三十萬眾北逐戎狄，收河南"
 },
 {
  "book": "shiji",
  "title": "史記/卷006",
  "quote": "自榆中并河以東，屬之陰山，以為三十四縣，城河上為塞"
 },
 {
  "book": "shiji",
  "title": "史記/卷006",
  "quote": "渡河取高闕、陽山、北假中，筑亭障以逐戎人"
 },
 {
  "book": "shiji",
  "title": "史記/卷006",
  "quote": "徙謫，實之初縣"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "筑長城，因地形，用制險塞，起臨洮，至遼東，延袤萬餘里"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "通道，自九原抵甘泉，塹山堙谷，千八百里"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "因地形，用制險塞"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "暴師於外十餘年"
 },
 {
  "book": "shiji",
  "title": "史記/卷087",
  "quote": "以兵屬蒙恬，與喪會咸陽而葬"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "塹山堙谷，通直道，固輕百姓力矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "天下之心未定，痍傷者未瘳"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "不以此時彊諫，振百姓之急，養老存孤，務修眾庶之和，而阿意興功"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "蒙恬疑而復請之"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "屬吏，更置"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "毅不敢阿法，當高罪死，除其宦籍"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "已聞扶蘇死，即欲釋蒙恬"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "恐蒙氏復貴而用事，怨之"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "日夜毀惡蒙氏"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "外使鬬士之意離"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "恬任外事而毅常為內謀，名為忠信，故雖諸將相莫敢與之爭焉"
 },
 {
  "book": "shiji",
  "title": "史記/卷087",
  "quote": "功高孰與蒙恬？謀遠不失孰與蒙恬？無怨於天下孰與蒙恬？長子舊而信之孰與蒙恬"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "自揃其爪以沈於河"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "過可振而諫可覺也"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "凡臣之言，非以求免於咎也，將以諫而死"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "其勢足以倍畔"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "自知必死而守義"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "疑而復請之"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "自吾先人，及至子孫，積功信於秦三世矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "辱先人之教"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "固輕百姓力"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "攻齊，大破之"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "暴師於外十餘年，居上郡"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "因家世得為秦將"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "書獄典文學"
 },
 {
  "book": "shiji",
  "title": "史記/卷006",
  "quote": "城河上為塞"
 },
 {
  "book": "shiji",
  "title": "史記/卷006",
  "quote": "筑亭障以逐戎人"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "名為忠信，故雖諸將相莫敢與之爭"
 },
 {
  "book": "shiji",
  "title": "史記/卷087",
  "quote": "以兵屬蒙恬"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "秦之大臣謀士也"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "恐蒙氏復貴"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "甚尊寵蒙氏，信任賢之"
 },
 {
  "book": "shiji",
  "title": "史記/卷087",
  "quote": "無怨於天下"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "積功信於秦三世"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "過可振而諫可覺也。察於參伍，上聖之法也"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "臣受詔行法於將軍，不敢以將軍言聞於上也"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "即欲釋蒙恬"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "不敢辱先人之教，以不忘先主也"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "今恬之宗，世無二心"
 },
 {
  "book": "shiji",
  "title": "史記/卷087",
  "quote": "以數直諫上"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "痍傷者未瘳"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "不以此時彊諫，振百姓之急"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "用道治者不殺無罪，而罰不加於無辜"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "使臣得死情實"
 },
 {
  "book": "shiji",
  "title": "史記/卷088",
  "quote": "走而奔於楚"
 },
 {
