[
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "礦稅事，朕因殿工未竣，權宜采取，今可與江南織造、江西陶器俱止勿行，所遣內監皆令還京"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "中使二十輩至閣中取前諭"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "一貫欲不予，中使輒搏顙幾流血，一貫惶遽繳入"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "相公稍持之，礦稅撤矣，何怯也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "萬死不敢奉詔"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "托孤寄命，必忠貞不二心之臣，乃可使百官總己以聽。茍非其人，不若躬親聽覽之為孝也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "以為刺己，頗憾一貫"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "廷臣爭十餘年不決"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "責戶部進銀二千四百萬，為冊立、分封諸典禮費以困之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "礦稅使四出為民害"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "久不視朝，閣臣屢請，皆不報"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "一見帝而已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "輔政十有三年，當國者四年"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "迫群議，請冊立、冠婚並行"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "帝復留不下"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "不正名而茍成事，是降儲君為諸王也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "既而帝復悔，令改期"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "冊立禮成，時論頗稱之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "慮貢道出寧波，為鄉郡患，極陳其害，貢議乃止"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "共著論以風，又嘗因事屢爭"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "相公稍持之，礦稅撤矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "礦稅之害，遂終神宗世"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "納王重賄，令通政司格其疏月餘"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "方銜正域與鯉"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "大索鯉私第三日，發卒圍正域舟，執掠其婢仆乳媼，皆無所得"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "言於帝，以京察疏留"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "二百餘年計典無特留者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "至楚宗、妖書、京察三事，獨犯不韙，論者醜之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "謂弛獄須再請"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "並二事寢不行"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "事誌臯等惟謹"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "疏辨，激上怒罷"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "惟引咎，帝乃慰留之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "十七疏求去"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "以文章氣節著"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "以清嚴自持相標置"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "寢其議。由是益惡正域"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "浙人與公論忤，由一貫始"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "佳兒佳婦付與先生，惟輔之為賢君"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "朕見先生止此矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "哭，太后、太子、諸王皆哭"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "發卒圍正域舟，執掠其婢仆乳媼"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "事皆取決於一貫"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "簡用沈鯉、朱賡"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "閣臣九卿俱直宿朝房"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "上下否隔甚"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "搏顙幾流血"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "先冠婚後冊立"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "顧遇一貫厚，嘗特賜敕獎之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "二百餘年計典"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "其鄉人亦多受世詆諆"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "家居久，故有清望"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "時論頗稱之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "論者醜之，雖其黨不能解免也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "茍非其人，不若躬親聽覽之為孝也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "今尚書求去者三，請定去留"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "復叩首，出擬旨以進"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "嗾給事中錢夢臯、楊應文劾"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "以京察疏留"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "帝意亦頗悟"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "小臣謝廷讃乘機邀功"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "屢請增閣臣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "枝拄清議，好同惡異，與前後諸臣同"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "論者益訾其有內援焉"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "與鯉、賡共著論以風，又嘗因事屢爭"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "大臣言官疏請者日相繼，皆不復聽"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "居正卒，始遷左中允"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "為錫爵、誌臯所薦"
 },
 {
  "book": "mingshi",
  "title": "明史/卷218",
  "quote": "所誣劾逮系者，悉滯獄中"
 }
]