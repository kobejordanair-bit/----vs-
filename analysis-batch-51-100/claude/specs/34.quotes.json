[
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "天下太平久，人不知戰。然事有逆順，勢有奇變，臣請馳至東京，悉府庫募驍勇，挑馬箠度河，計日取逆胡首以獻闕下"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "臣所將之兵，皆是烏合之徒，素未訓習。率周南市人之眾，當漁陽突騎之師"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "守胡城南門，頗讀書，每坐常清於城門樓上，教其讀書"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "孤貧，年三十餘"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "領兇徒十萬，徑犯中原"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "太平斯久，人不知戰"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "具言仙芝、常清逗撓奔敗之狀"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "傭保市井之流"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "於幕中潛作捷書，具言次舍井泉，遇賊形勢，克獲謀略，事頗精審"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "副大使幕下何得有如此人"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "專知四鎮倉庫、屯田、甲仗、支度、營田事"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "常令常清知留後事"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "威望動三軍"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "走馬突常清而去"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "郎將須暫死以肅軍容"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "杖六十，面仆地，曳出"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "常清亦不之謝"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "軍中莫不股栗"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "旬日得兵六萬"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "斫斷河陽橋，於東京為固守之備"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "使驍騎與柘羯逆戰，殺賊數十百人"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "倒樹以礙之"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "購祿山檄數十函"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "以分曉諸郡"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "潼關無兵，一夫奔突則京師危，不如急守潼關"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "計日取逆胡首"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "皆傭保市井之流"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "退入上東門，又戰不利"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "逗撓奔敗之狀"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "觀楊國忠之奏事，邊令誠之護戎，又掣肘於軍政者也，未可偏責三帥"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "細瘦目類腳短而跛"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "見其貌寢，不納"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "吾奏傔已足，何煩復來"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "怒，倨謂仙芝曰"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "公若方圓取人，則士大夫所望；若以貌取人，恐失之子羽矣"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "候仙芝出入，晨夕不離其門，凡數十日"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "每出征或乘驛，私馬不過一兩匹，賞罰嚴明"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "才而果，胸無疑事"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "出軍乘騾，私廄裁二馬"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "倉庫、屯田、甲仗、支度、營田"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "白衣於仙芝軍效力"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "三度遣使奉表"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "具言次舍井泉，遇賊形勢，克獲謀略"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "市人之眾，當漁陽突騎之師"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "與一子五品官，賜第一區，亡父母皆贈封爵"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "揖仙芝，命常清進坐，與語如舊相識"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "常清起自細微，預中丞兵馬使傔，中丞再不納，郎將豈不知乎"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "計日取逆胡之首懸於闕下"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "衣皁衣以從事"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "前後三度遣使奉表"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "自草表待罪"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "常清所以不死者，不忍汙國家旌麾，受戮賊手，討逆無效，死乃甘心"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "臣欲挺身刃下，死節軍前，恐長逆胡之威，以挫王師之勢"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "晨夕不離其門，凡數十日"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "常清起自細微"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "亡父母皆贈封爵"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "事有逆順，勢有奇變"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "臣所將之兵，皆是烏合之徒，素未訓習"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "陛下或以臣失律之後，誑妄為辭"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "代我為節度使"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "遂無一言，常清亦不之謝"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "封二，子從微至著，我則引拔子為我判官，俄又代我為節度使，今日又與子同死於此，豈命也夫"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "臣讀《春秋》，見狼瞫稱未獲死所，臣今獲矣"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "問臣以逆賊之勢"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "具言次舍井泉，遇賊形勢"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "計日取逆胡之首"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "常清乃驅市人數萬以嬰賊鋒，一戰不勝，即奪爵土"
 },
 {
  "book": "xintangshu",
  "title": "新唐書/卷135",
  "quote": "彼二將奚誅焉"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷104",
  "quote": "臣死之後，望陛下不輕此賊，無忘臣言"
 }
]