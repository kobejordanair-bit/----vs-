[
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "三五星散，解鞍束甲坐道旁"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "公受命犒師，不受命督戰，他人壞之，公任其咎乎"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "危及社稷，吾將安避"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "六歲誦《九經》，七歲能屬文"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "蜀士多屏棄"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "運糧造舟者多"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "我將看花洛陽"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "自將，兵號百萬"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "自渦口渡淮"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "自和州遁歸"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "盡失兩淮矣"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "坐待顯忠則誤國事"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "金帛、告命皆在此，待有功"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "今既有主，請死戰"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "列大陣不動，分戈船為五"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "抵南岸者七十艘"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "汝膽略聞四方，立陣後則兒女子爾"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "授以旗鼓，從山後轉出，敵疑援兵至，始遁"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "敵今敗，明必復來"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "焚其舟三百"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "改修馬船為戰艦"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "三周金山，回轉如飛"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "南軍有備，未可輕"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "為其下所殺"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "閱實諸軍，第其壯怯為三"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "汰兵凡萬人，減緡錢四百萬"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "見軍皆少壯"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "虞允文行沙汰之效也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "棄雞肋之無多，免狼心之未已"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "以笏畫地，陳其利害"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "此史浩誤朕"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "五上疏力爭"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "金兵復至，思退貶，上悔不用允文言"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "敵兵實四十萬，馬倍之，宋軍才一萬八千"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "丙午之恥，當與丞相共雪之"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "許上以恢復"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "使蜀一歲，無進兵期"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "軍需未備，上不樂"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "三軍有怨語"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "姿雄偉，長六尺四寸，慷慨磊落有大志，而言動有則度，人望而知為任重之器"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "一發破的，眾驚異之"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "兵來不除道，敵為虛聲以分我兵"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "奉遷陵寢來歸"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "金方懲亮，決不輕動，不過以虛聲撼我耳"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "朝論紛然，允文屹不動，敵卒無他"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "籍人才為三等"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "之敏端方，請召歸以辟言路"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "采石之功，之敏在何許"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "金帛、告命皆在此"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "朕之裴度也"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "他人壞之，公任其咎乎"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "姿雄偉，長六尺四寸"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "金必敗盟，兵出有五道"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "敵為虛聲以分我兵"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "從山後轉出"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "三軍無怨言"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "大駕既興，難再御殿"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "前後凡十五疏"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "兵來不除道，敵為虛聲以分我兵，成其出淮姦謀爾"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "是一軍而兩用之"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "恢復莫先於陝西，陝西五路新復州縣又係於德順之存亡，一旦棄之，則窺蜀之路愈多"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "大言誤國，以邀美名"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "權已置典憲，新將李世輔也，願一戰以決雌雄"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "和則海內氣沮，戰則海內氣伸"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "若西師出而朕遲回，即朕負卿；若朕已動而卿遲回，即卿負朕"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "異時戒內外不相應"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "金方懲亮，決不輕動"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "今日有八可戰"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "丁母憂，哀毀骨立"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "七年不調，跬步不忍離左右"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "待命浙江亭，兩日不報"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "請對，極論體貌之道，疊拜榻前"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "遮道訴繫縲之苦"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "分給官田，俾咸振業"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "捐宣司錢三十萬易米，計口增給"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "不足贍其家"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "以虛聲撼我"
 },
 {
  "book": "songshi",
  "title": "宋史/卷383",
  "quote": "期以某日會河南"
 }
]