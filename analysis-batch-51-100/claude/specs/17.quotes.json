 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "彈穿脅，猶持刀潰圍出，乃死"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "坐山巔督戰"
