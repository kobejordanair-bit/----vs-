 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "詣經略洪承疇降"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "兵潰，妻子俱散失"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "自卯至午短兵接，死者如堵牆"
