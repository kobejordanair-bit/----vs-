 {
  "book": "qingshigao",
  "title": "清史稿/卷234",
  "quote": "有德令其孥以火殉，遂自經"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "自率精騎追之，遇伏，沒於陣"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷216",
  "quote": "我軍擊賊無退者。我為宗室，退，何面目歸乎"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷216",
  "quote": "陷淖中，矢盡，拔刀戰，力竭，歿於陣"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "轉戰廣西、湖廣，下數十城，兵屢勝，可望益嫉之"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "察其意，辭不赴"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "會雙禮追定國"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "感泣，議奉迎"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "棄其軍奔定國"
