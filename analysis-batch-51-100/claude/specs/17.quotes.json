 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "土坌起撲面"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "上三十餘疏迎桂王，為吉翔所阻，不得達"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷474",
  "quote": "李定國、白文選等分住三宣六慰，以擁戴為名，引潰眾肆擾，其患在門戶"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "引兵橫擊之，緬人大敗"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "終不肯出桂王"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "為緬人所焚"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "以降將受命敗軍後，崎嶇險阻，百折而不撓，比之擴廓帖木兒、陳友定輩，何多讓焉"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "率所部出降"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "念兄事久，未可遽發難"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
