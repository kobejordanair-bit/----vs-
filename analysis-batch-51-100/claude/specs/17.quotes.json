  "title": "明史/卷120",
  "quote": "聞李定國與可望有隙，遣使密召定國，以兵來迎"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "定國軍中象陣略退，斬馭象者以徇，所部戰甚力，驅象突陣，有德敗績，退保桂林"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷224",
  "quote": "晝夜環攻，城陷，有德自殺"
