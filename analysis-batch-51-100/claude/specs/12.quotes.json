[
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "山人柳泌輕懷左道。上惑先朝"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "付京兆府決杖處死"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "日加躁渴，遽棄萬國"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "餌金石之藥"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "悅，召之，求皋不獲"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "崩於寢殿，時年三十"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "上表請朝廷命帥"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "左右軍中尉馬進潭、梁守謙、魏弘簡等請立門戟，從之"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "元和之政，幾致升平"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "平、勃之佐，繼以文、景之才"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "宰臣蕭俯等不顧遠圖，乃獻銷兵之議，請密詔天下軍鎮，每年限百人內破八人逃死"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "情願居農者放，逃戶者不捕"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "宰相崔植、杜元穎素不知兵，心無遠慮，謂兩河無虞，不復禍亂矣，遂奏劉總所籍大將並勒還幽州"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "節度使田弘正並家屬將佐三百餘口並遇害"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "自潰於南宮縣"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "上於馭軍之道，未得其要，常雲宜姑息其臣。故即位之初，傾府庫頒賞之"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "非時賜與，不可勝紀。故軍旅益驕，法令益弛，戰則不克，國祚日危"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "名臣扼腕，無如之何"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "盛飾安國、慈恩、千福、開業、章敬等寺，縱吐蕃使者觀之"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "三日一幸左右軍"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "與中宮貴主密宴以樂之"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "與內官擊鞠禁中"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "足不能履地，風眩就床"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "外不聞上起居者三日"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "劉總進馬一萬五千匹"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "不知創業之艱難，不恤黎元之疾苦"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "此何人哉，遽主鼎命"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "大合樂於魚藻宮"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "傾府庫頒賞之，長行所獲，人至巨萬"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "上恐，罷鞠升殿"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "詔五坊鷹隼並解放，獵具皆毀之"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "守本官、同平章事"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "於馭軍之道，未得其要"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "幸右軍擊鞠，遂畋於城西"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "謂兩河無虞"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "據時估減半價出糶"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "傾府庫頒賞"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "以大將文符鬻之富賈"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "聚則萬乘，散則獨夫，朝作股肱，暮為仇敵"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "傾府庫頒賞之"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "欻然墜馬，如物所擊"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "上恐，罷鞠升殿，足不能履地，風眩就床"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "五十載已終之土，復入提封"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "密宴以樂之"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "上餌金石之藥"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "皇太后移居興慶宮，皇帝與六宮侍從大合宴於南內"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷16",
  "quote": "曲宴郭釗兄弟、貴戚、主婿等於宣和殿"
 }
]