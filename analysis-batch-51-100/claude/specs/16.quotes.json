[
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "乘勢躍而上，大呼跳蕩，元軍披靡"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "不慮不能戰，慮輕戰耳。身為大將，顧好與小校角，甚非所望也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "貌奇偉，勇力絕人，猿臂善射"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "察聚終無成"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "一時名將稱徐、常"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "諸將乘之，遂拔採石，進取太平"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "操輕舸，沖海牙舟為二"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "遇春射中定邊，太祖舟得脫"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "縱火焚漢舟，湖水皆赤"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "單騎突其陣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "一矢殪其前鋒，大呼馳入"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "中流矢，裹創鬥，克之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "以奇兵突入南門甕城，毀其戰具"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "太祖左右軍皆敗，遇春橫擊其陣，三戰三破之，俘獲士馬無算"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "將奇兵由大全港營東阡，更出其後"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "數從征伐，聽約束惟謹"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "我騎兵雖集，步卒未至，驟與戰必多殺傷，夜劫之可得志"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "跣一足，乘孱馬，以十八騎走大同"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "溯江而上，諸將從之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "詔改遇春左副將軍，居右副將軍馮勝上"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "斬首萬人，生擒三千人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "此勁旅也，不殺為後患"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "先以夜坑其人過半，太祖不懌，悉縱遣餘眾"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "克城無多殺。苟得地，無民何益"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "浚壕立柵以困之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "遇春果不殺"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "大喜，賜書褒勉"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "人臣以反名，尚何可宥，臣義不與共生"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "飲榮酒，流涕而戮之，以是益愛重遇春"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "帥步騎九萬，發北平"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "分千騎為八伏"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "追奔數百里"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "師還，次柳河川，暴疾卒，年僅四十"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "為將不妄殺人，豈惟國家之利，爾子孫實受其福"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "聽約束惟謹"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "用法嚴，軍民肅然無敢犯"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "能將十萬眾，橫行天下"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "摧鋒陷陣，未嘗敗北"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "勇力絕人，猿臂善射"
 },
 {
  "book": "mingshi",
  "title": "明史/卷125",
  "quote": "好與小校角"
 },
 {
