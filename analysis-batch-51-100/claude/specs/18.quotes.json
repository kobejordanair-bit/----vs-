[
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "必恐蒙圖其後故也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "以治疾為名"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "必撤備兵，盡赴襄陽"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "使白衣搖櫓，作商賈人服，晝夜兼行"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "欲以肉餧虎"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "雄烈，膽略兼人"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "學問開益，籌略奇至，可以次於公瑾"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "圖取關羽，勝於子敬"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "勇而有謀，斷識軍計，譎郝普，禽關羽，最其妙者"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "初雖輕果妄殺，終於克己，有國士之量，豈徒武將而已乎"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "貧賤難可居，脫誤有功，富貴可致。旦不探虎穴，安得虎子"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "彼堅子何能為？此欲以肉餧虎耳"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "大怒，引刀殺吏"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "陳列赫然，兵人練習"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "今東西雖為一家，而關羽實熊虎也，計安可不豫定"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "為肅畫五策"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "呂子明，吾不知卿才畧所及乃至於此也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "遂拜蒙母，結友而別"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "彼方首尾倒懸，救死不給"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "出書示之。因拊手大笑"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "留凌公績，蒙與君行，解圍釋急，勢亦不久，蒙保公績能十日守也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "分遣三百人柴斷險道，賊走可得其馬"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "騎皆捨馬步走"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "獲馬三百匹"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "地勢陸通，驍騎所聘"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "後旬必來爭，雖以七八萬人守之，猶當懷憂。不如取羽，全據長江，形勢益張"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "盡得羽及將士家屬，皆撫慰，約令軍中不得乾歷人家，有所求取"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "不可以鄉里故而廢法，遂垂涕斬之"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "於是軍中震慄，道不拾遺"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "輒厚遇其使，周遊城中，家家致問"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "見待過於平時"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "故羽吏士無鬬心"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "眾皆委羽而降"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "據前所立塢，置強弩萬張於其上"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "皖田肥美，若一收孰，彼眾必增"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "手執枹鼓，士卒皆騰踴自升，食時破之"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "年四十二，遂卒於內殿"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "君欲為祁奚耶"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "天下未定，鬥將如寧難得，宜容忍之"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "為擇師，使輔導之"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "置強弩萬張"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "軍中震慄，道不拾遺"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "勒前鋒，親梟就首"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "手執枹鼓，士卒皆騰踴自升"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "白衣搖櫓，作商賈人服"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "不如取羽，全據長江"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "旦暮使親近存卹耆老，問所不足，疾病者給醫藥，饑寒者賜衣糧"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "皆封閉以待權至"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "誅其首惡，餘皆釋放，復為平民"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "少不修書傳"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "拜蒙母，結友而別"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "將何計畧以備不虞"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "關羽實熊虎也，計安可不豫定"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "首尾倒懸，救死不給"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "曾不移日，而城必破"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "令百歲老母，戴白受誅，豈不痛哉"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "少不修書傳，每陳大事，常口占為箋疏"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "露檄召蒙還，陰與圖計"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "諸將討擊不能禽"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "鷙鳥累百，不如一鶚"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "旦不探虎穴，安得虎子"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "學問開益，籌略奇至"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "豈徒武將而已乎"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "羽君臣，矜其詐力，所在反覆，不可以腹心待也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "宜相輔協，與之同仇"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "帝王之起，皆有驅除，羽不足忌"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "內不能辦，外為大言"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "常穿壁瞻之，見小能下食則喜"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "命道士於星辰下為之請命"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "或手書示信"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷54",
  "quote": "慕化遠來，於義宜益不宜奪"
 }
