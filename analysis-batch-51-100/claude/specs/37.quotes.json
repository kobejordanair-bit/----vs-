[
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "兄終弟及，誰能瀆焉！興獻王長子，憲宗之孫，孝宗之從子，大行皇帝之從弟，序當立"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "封還御批者四，執奏幾三十疏"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "自詭門生天子、定策國老"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "先其父成進士"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "性沈靜詳審"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "好考究掌故、民瘼、邊事及一切法家言"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "恒不視朝，恣遊大同、宣府、延綏間，多失政"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "擁重兵在肘腋間"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "吾於文翰，頗有一日之長，若經濟事須歸介夫"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "當繼統，不繼嗣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "以遺詔令太監張永、武定侯郭勛、安邊伯許泰、尚書王憲選各營兵，分布皇城四門、京城九門及南北要害"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "罷威武營團練諸軍"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "豹房番僧及少林僧、教坊樂人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "廷和總朝政幾四十日"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "放遣四方進獻女子，停京師不急工務，收宣府行宮金寶歸諸內庫"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "往者事齟齬，動稱上意。今亦新天子意耶"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "所裁汰錦衣諸衛、內監局旗校工役為數十四萬八千七百，減漕糧百五十三萬二千餘石"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "由陛下初年詔書裁革冗員所致"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "此楊廷和功，不可沒也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "文士也，不任此"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "所戒者班師早耳"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "楊公先見，吾不及也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "收其護衛屯田"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "頗以鎮靜持重，為中外所推服"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "有異議者即奸邪，當斬"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "恐其撓議，改瓚官南京"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "秀才安知國家事體"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "未嘗不諫，俱不聽"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "亦不能執奏"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "不能有所裁禁，以是得稍自安"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "或疑法司承廷和指者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "人或謂廷和太專"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "與東陽委曲其間，小有劑救而已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "天子至尊，不敢瀆獻"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "威武大將軍"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "臣不敢阿諛順旨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "未聞追崇其所生父"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "每召廷和從容賜茶慰諭"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "卒不肯順帝指"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "復四辭而止"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "閣臣之得終父母喪者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "總朝政幾四十日"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "不能有所裁禁"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "入朝有挾白刃伺輿旁者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "營卒百人衛出入"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "請擢邊將仇鉞，以離賊黨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "正德中蠹政厘抉且盡"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "且頌廷和功"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "常忽忽有所恨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "經濟事須歸介夫"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "廷臣諍者百餘人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "給事、御史請留廷和"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "諸失職之徒銜廷和次骨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "乘間言廷和恣無人臣禮"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "門生天子、定策國老"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "忘所後而重本生，任私恩而棄大義"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "今亦新天子意耶"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "請捐萬金購之草澤"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "心知所謂，不應，而微以倫序之說風之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "良久未報，廷和、冕益自危"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "十餘條，皆切至"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "數移疾乞骸骨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "不誅此曹，則國法不正，公道不明"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "陛下能獨與二三邪佞共治祖宗天下哉"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "創自成化、弘治耳"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "為所後者為父母"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "遺詔以吾嗣皇帝位，非為皇子也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "由大明門直入"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "帝為薄謫道、嘉以安廷和，然意內移矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "乞奔喪，不許。三請乃許"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "邑邑不自得，數移疾乞骸骨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "率群臣伏闕哭爭，杖謫雲南"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "法當僇市，姑削職為民"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "俱逮下詔獄"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "鞫治無狀，乃得解"
 },
 {
  "book": "mingshi",
  "title": "明史/卷190",
  "quote": "兄終弟及，誰能瀆焉"
 }
]