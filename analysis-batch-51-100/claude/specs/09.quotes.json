[
 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "垂簾聽政，本萬不得已之舉"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "使訓政永無底止"
