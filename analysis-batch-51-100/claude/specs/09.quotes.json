 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "垂簾非所樂爲，惟以時事多艱"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "是以姑允所請。俟皇帝典學有成，即行歸政"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "兩太后同心求治，登進老成，倚任將帥，粵、捻蕩平，滇、隴漸定"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "我朝未明定儲位，可讀所請，與家法不合"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "其繼大統者為穆宗嗣子"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷214",
  "quote": "定策立德宗"
