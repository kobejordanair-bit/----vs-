 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "不就，於是口不論世事，唯雅詠玄虛而已"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "眾共推為元帥"
