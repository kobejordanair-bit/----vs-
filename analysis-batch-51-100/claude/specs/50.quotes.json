 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "孩抱中物，何至於此"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "聖人忘情，最下不及於情。然則情之所鐘，正在我輩"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "服其言，更為之慟"
