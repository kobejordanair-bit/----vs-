 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "妙善玄言，唯談《老》《莊》為事"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "選舉登朝，皆以為稱首"
