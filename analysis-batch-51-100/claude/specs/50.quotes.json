 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "荊州有江、漢之固，青州有負海之險，卿二人在外，而吾留此，足以為三窟矣"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷043",
  "quote": "懼禍，自表離婚"
