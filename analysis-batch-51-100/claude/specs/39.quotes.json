[
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "我促敵二百里外，敵促我二百里中，勢又辨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "臣不敢為百年久計，只計及五年間究竟何如。倘臣言不當，立斥臣以定大計"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "請撤關外以守關內"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "貌奇偉，須髯戟張。與人言，聲殷牆壁"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "往來飛狐、拒馬間"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "喜從材官老兵究問險要厄塞，用是曉暢邊事"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "沈、遼相繼失"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "築重關，用四萬人守之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "力爭不能得"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "不與交一言"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "論冒餉者復踵至"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "如此，則八里內守兵八萬矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "為敵人設，抑為新兵設乎"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "兵未潰而築寨以待之，是教之潰也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "今不為恢復計，畫關而守，將盡撤籓籬，日哄堂奧，畿東其有寧宇乎"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "在晉無以難"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "八里築城之議遂熄"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "以原官督山海關及薊、遼、天津、登、萊諸處軍務，便宜行事，不從中制"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "汰逃將數百人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "承宗在關四年，前後修復大城九、堡四十五，練兵十一萬，立車營十二、水營五、火營二、前鋒後勁營八"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "拓地四百里，開屯五千頃，歲入十五萬"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "率所部萬五千人東潰"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "大壽危疑已甚"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "當大開生路，曲收眾心"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "密札諭大壽急上章自列，且立功贖督師罪"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "得灤、永則關、永合，而取遵易易矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "有柳河之敗，死者四百餘人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "先據右屯，築城大凌河，以漸而進"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "大至，圍數周"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "大敗於長山"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "築壇，拜行授鉞禮"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "論世龍不已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "事連貴妃，不可深問。龐保、劉成而下，不可不問也；龐保、劉成而上，不可深問也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "齎內庫神砲、甲仗"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "中使觀兵，自古有戒"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "具杯茗而已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "擁兵數萬將清君側"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "一襆被置輿中，後車鹿善繼而已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "並讞，用正朝士黨護"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "諸人以次獲譴，朝右聳然"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "後皆為求宥"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "請免死遣戍"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "全活千餘人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "廣寧，我遠而敵近；寧遠，我近而敵遠。我不進逼敵，敵將進而逼我"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "速畀臣餉二十四萬"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "許而不與，文移往復稽緩之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "邊疆小勝小敗，皆不足問"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "無旨離信地，非祖宗法"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "修復大城九、堡四十五，練兵十一萬"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "拓地四百里"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "一晝夜穿鑿百井"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "死者四百餘人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "推心告語凡七晝夜"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "貌奇偉，須髯戟張"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "從二十七騎出東便門"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "率家人拒守"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "我促敵二百里外，敵促我二百里中"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "非部下盡欲叛也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "便宜行事，不從中制"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "所條畫俱稱旨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "朝右聳然，而側目怨咨者亦眾矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "爭請召承宗"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "中外屢請召用"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "敵未抵鎮武而我自燒寧、前，此前日經、撫罪也；我棄寧、前，敵終不至，而我不敢出關一步，此今日將吏罪也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "此臣與經臣罪也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "請身往決之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "復出關巡視"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "集將吏議所守"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "即周閱都城，五鼓而畢，復出閱重城"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "從二十七騎出東便門，道亡其三"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "門者幾不納"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "皆廩之於官"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "將盡撤籓籬，日哄堂奧，畿東其有寧宇乎"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "敵人之帳幕必不可近關門，杏山之難民必不可置膜外"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "究問險要厄塞"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "力辭太傅不受"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "只計及五年間究竟何如"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "章疏數十上"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "稱疾求罷，舉彥自代以困之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "廷議不可而止"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "比之王敦、李懷光"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "促敵二百里外"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "攻不足者守有餘"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "令專任之，猶足以慎固封守"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "望闕叩頭，投繯而死，年七十有六"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "當國者楊嗣昌、薛國觀輩陰扼之，但復故官，予祭葬而已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷250",
  "quote": "此城笑也，於法當破"
 }
]