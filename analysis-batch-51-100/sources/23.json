      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7290",
      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=1418408",
      "textSha256": "aede5fb5e23114b9c81eaaac5fc83097e8e8df3596137402bbaf089a62bbb20c",
      "contentPath": "/static/data/history/archive-books/songshi.json"
    },
