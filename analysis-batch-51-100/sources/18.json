  "priorReviews": [],
  "archiveCandidates": [
    {
      "documentId": "document:sanguozhi-08c20c0c624b4ed4",
      "query": "呂蒙",
      "count": 1,
      "offset": 7795,
      "excerpt": "以先主已得益州，使使報欲得荊州。先主言：「須得涼州，當以荊州相與。」權忿之，乃遣呂蒙襲奪長沙、零陵、桂陽三郡。先主引兵五萬下公安，令關羽入益陽。是歲，曹公定漢中，張魯遁走巴西。先主聞之，與權連和，分荊州、江夏、長沙、桂陽東屬，南郡、零陵、武陵西",
      "matchType": "name-occurrence",
      "title": "三國志/卷32",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E4%B8%89%E5%9C%8B%E5%BF%97%2F%E5%8D%B732",
      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=2583378",
      "textSha256": "b173c6988bb6b1fd0ca3228162b514c4a1634e6f8b6720405590cec6116a5bea",
      "contentPath": "/static/data/history/archive-books/sanguozhi.json"
    },
    {
      "documentId": "document:sanguozhi-a955592661573fad",
      "query": "呂蒙",
      "count": 1,
      "offset": 1547,
      "excerpt": "書以謝羽，許以自往。臣松之以為荊、吳雖外睦，而內相猜防，故權之襲羽，潛師密發。按呂蒙傳云：「伏精兵於𦩷〔字形：〈舟冓〉〕𦪇〔字形：〈舟鹿〉〕之中，使白衣搖櫓，作商賈服。」以此言之，羽不求助於權，權必不語羽當往也。若許相援助，何故匿其形跡乎？",
      "matchType": "name-occurrence",
      "title": "三國志/卷36",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E4%B8%89%E5%9C%8B%E5%BF%97%2F%E5%8D%B736",
      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=2583383",
      "textSha256": "3341547de18c8396b89ed9ce9e41854bed9543667b19e52e090845ace9b74952",
      "contentPath": "/static/data/history/archive-books/sanguozhi.json"
    },
    {
      "documentId": "document:sanguozhi-344e057bf04afb24",
      "query": "呂蒙",
      "count": 1,
      "offset": 3565,
      "excerpt": "皆誰相經緯者，亮答曰：「龐統、廖立，楚之良才，當贊興世業者也。」建安二十年，權遣呂蒙奄襲南三郡，立脫身走，自歸先主。先主素識待之，不深責也，以為巴郡太守。二十四年，先主為漢中王，徵立為侍中。後主襲位，徙長水校尉。 \n\n　　立本意，自謂才名宜為諸",
      "matchType": "name-occurrence",
      "title": "三國志/卷40",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E4%B8%89%E5%9C%8B%E5%BF%97%2F%E5%8D%B740",
      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=2583390",
      "textSha256": "bcc6ffcc39767718b60bbcc360ab092a81c944df31d1f68d230fc2d56598af60",
      "contentPath": "/static/data/history/archive-books/sanguozhi.json"
    },
    {
      "documentId": "document:sanguozhi-af5ba2e21ff88352",
      "query": "呂蒙",
      "count": 1,
      "offset": 11463,
      "excerpt": "；與羽有隙，叛迎孫權。郝普字子太，義陽人。先主自荊州入蜀，以普為零陵太守。為吳將呂蒙所譎，開城詣蒙。潘濬字承明，武陵人也。先主入蜀，以為荊州治中，典留州事，亦與關羽不穆。孫權襲羽，遂入吳。普至廷尉，濬至太常，封侯。\n\n〔《益部耆舊雜記》載王嗣、",
      "matchType": "name-occurrence",
      "title": "三國志/卷45",
