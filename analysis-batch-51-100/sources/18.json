      "contentPath": "/static/data/history/archive-books/songshu.json"
    },
    {
      "documentId": "document:songshu-991e5bf0d59e0f5f",
      "query": "呂蒙",
      "count": 1,
      "offset": 1315,
      "excerpt": "\n\n宜都太守，太康地志、王隱地道、何志並云吳分南郡立；張勃吳錄云劉備立。按吳志，呂蒙平南郡，據江陵，陸遜別取宜都，獲秭歸、枝江、夷道縣。初權與劉備分荊州，而南郡屬備，則是備分南郡立宜都，非吳立也。習鑿齒云，魏武平荊州，分南郡枝江以西為臨江郡，建",
      "matchType": "name-occurrence",
      "title": "宋書/卷37",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E6%9B%B8%2F%E5%8D%B737",
