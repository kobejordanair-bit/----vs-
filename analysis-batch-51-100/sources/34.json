      "contentPath": "/static/data/history/archive-books/xintangshu.json"
    },
    {
      "documentId": "document:xintangshu-09824c5d6737ead7",
      "query": "封常清",
      "count": 2,
      "offset": 3644,
      "excerpt": "不則就禽，日不絕。禁衛皆市井徒，既授甲，不能脫弓襡、劍，乃發左藏庫繒帛大募兵。以封常清為范陽、平盧節度使，郭子儀為朔方節度、關內支度副大使，右羽林大將軍王承業為太原尹，衛尉卿張介然為汴州刺史，金吾將軍程千里為潞州長史，以榮王為元帥，高仙芝副之，馳",
      "matchType": "name-occurrence",
      "title": "新唐書/卷225上",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%96%B0%E5%94%90%E6%9B%B8%2F%E5%8D%B7225%E4%B8%8A",
      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=2606365",
