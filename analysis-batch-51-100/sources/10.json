    {
      "documentId": "document:nanqishu-1b6f74b22cf5cbb0",
      "query": "梁武帝",
      "count": 1,
      "offset": 1667,
      "excerpt": "賜天下為父後者爵一級，孝子從孫，〔孝子從孫　「從」毛本、殿本作「順」。按蕭子顯避梁武帝父蕭順之諱，「順」字皆改為「從」字，作「順」者，蓋後人所改。〕義夫節婦，普加甄賜明揚。表其衡閭，賚以束帛。己丑，詔「東宮肇建，遠近或有慶禮，可悉斷之」。壬辰，以",
      "matchType": "name-occurrence",
      "title": "南齊書/卷6",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8D%97%E9%BD%8A%E6%9B%B8%2F%E5%8D%B76",
      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=2311630",
