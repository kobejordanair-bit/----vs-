      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=2312008",
      "textSha256": "f69566fae5df057a6ffc6a95694820b10aafabe9c65aa03e72eebc2193ea8fe1",
      "contentPath": "/static/data/history/archive-books/nanqishu.json"
