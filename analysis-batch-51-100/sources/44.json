      "contentPath": "/static/data/history/archive-books/qingshigao.json"
    },
    {
      "documentId": "document:qingshigao-657c92f8534be9a9",
      "query": "和珅",
      "count": 1,
      "offset": 6944,
      "excerpt": "華薦舉人楊昌霖，同典秘籍。後皆改入翰林，時稱「五徵君」。此其著者也。\n\n嘉慶初，和珅敗，仁宗下詔求賢。諭滿、漢大臣，密舉操守端潔、才猷幹濟、居官事迹可據者，降敕褎擢廉吏劉清，風厲天下。十九年，御史卓秉恬請嚴禁濫保，帝是之。宣宗即位，尚書劉鐶之薦",
      "matchType": "name-occurrence",
      "title": "清史稿/卷109",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7109",
