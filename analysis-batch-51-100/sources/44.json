      "contentPath": "/static/data/history/archive-books/qingshigao.json"
    },
    {
      "documentId": "document:qingshigao-efba52325d817726",
      "query": "和珅",
      "count": 1,
      "offset": 9403,
      "excerpt": "隆六十年乙卯，會元為浙江王以鋙，第二名即其弟以銜，帝心異之。正總裁侍郎竇光鼐素與和珅不協，且以詆訶後進忤同列，均欲藉以傾之。因摘兩人闈墨中並有「王道本乎人情」語，以為關節。抑寘以鋙榜末，停其殿試，降光鼐四品休致，鐫副總裁侍郎劉躍雲、祭酒瑚圖禮四",
      "matchType": "name-occurrence",
      "title": "清史稿/卷108",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7108",
      "revisionUrl": "https://zh.wikisource.org/w/index.php?oldid=2607790",
