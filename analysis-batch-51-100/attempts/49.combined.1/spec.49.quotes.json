[
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "望輕，不與也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "謙益結黨受賄，舉朝無一人敢言者，臣不忍見皇上孤立於上，是以不得不言"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "微體仁，朕幾誤"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "體仁方食，失匕箸"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "為人外謹而中猛鷙，機深刺骨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "帝久疑廷臣植党"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "流寇躪畿輔，擾中原，邊警雜遝，民生日困"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "魏忠賢遺黨日望體仁翻逆案，攻東林"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "與東林相應和"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "獨體仁居位八年"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "恩禮優渥無與比"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "未嘗建一策，惟日與善類為仇"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "關節受賄，神奸結黨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "如允儒言，乃真黨也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "叱允儒下詔獄"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "臣等雜治千秋，觀聽者數千人，非一手一口所能掩。體仁顧欺岡求勝"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "惟詆於汴等黨護而已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "抑買商人木"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "作詩頌魏忠賢"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "娶娼、受金，奪人產"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "詰辯良久，言二人皆謙益死黨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "亦卒無左驗"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "自體仁輔政後，同官非病免物故，即以他事去"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "帝固不甚怒也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "君子小人不並立"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "謫紹傑於外"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "念朝士多與為怨，不敢恣肆，用廉謹自結於上，苞苴不入門"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "臣夙以文章待罪禁林"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "顧臣愚無知，但票擬勿欺耳。兵食之事，惟聖明裁決"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "以為樸忠，愈親信之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "既而賊大至，焚皇陵"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "僅釋十餘人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "魏忠賢遺黨日望體仁翻逆案"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "陰使侍郎張捷舉逆案呂純如以嘗帝"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "言者大嘩，帝亦甚惡之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "自是不敢訟言用逆黨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "不承風指，皆降謫之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "倡言密勿之地，不宜宣洩，凡閣揭皆不發，並不存錄閣中，冀以滅跡"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "所欲推薦，陰令人發端，己承其後。欲排陷，故為寬假，中上所忌，激使自怒。帝往往為之移，初未嘗有跡"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "左右未得人"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "由臣不能表率"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "比為謙益故，排擊臣者百出。而無一人左袒臣，臣孤立可見"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "謂體仁孤立，益響之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "復力求去以要帝"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "擬旨逮二人下詔獄嚴訊"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "自請案治，乃盡得漢儒等奸狀及體仁密謀"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "陰令人發端"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "閣揭皆不發，並不存錄閣中"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "凡異己者，率以部議論罷"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "其所引與同列者，皆庸材，苟以充位"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "未嘗建一策"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "惟倡眾捐俸助馬修城而已"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "賊大至，焚皇陵"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "惟聖明裁決"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "臣不忍見皇上孤立於上"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "欲排陷，故為寬假，中上所忌，激使自怒"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "盡得漢儒等奸狀及體仁密謀"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "居位八年，官至少師兼太子太師，進吏部尚書、中極殿大學士，階左柱國"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "所上密揭，帝率報可"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "猶惜之，贈太傅，諡文忠"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "當國既久，劾者章不勝計"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "十二罪、六奸"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "削其贈諡，天下快焉"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "皆效法體仁，蔽賢植黨，國事日壞"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "時大臣無助體仁者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "嘗面責體仁"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "皆謙益死黨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "臣愚無知，但票擬勿欺耳"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "臣票擬多未中窾要，每經御筆批改，頌服將順不暇，詎能窺上旨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "竟下獄削籍"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "臣職非言官不可言，會推不與，宜避嫌不言"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "臣孤立可見"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "佯引疾，意帝必慰留"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "以才望遷詹事"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "惟日與善類為仇"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "不為救，竟棄市"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "陰令人發端，己承其後"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "凡閣揭皆不發，並不存錄閣中，冀以滅跡"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "皆效法體仁"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "帝始悟體仁有黨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "皆奉體仁指"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "外謹而中猛鷙，機深刺骨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "愈以為孤立，每斥責言者以慰之，至有杖死者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "久疑廷臣植党"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "用御史史褷、高捷及侍郎唐世濟、副都御史張捷等為腹心"
 },
 {
  "book": "mingshi",
  "title": "明史/卷308",
  "quote": "蔽賢植黨，國事日壞，以至於亡"
 }
