 {
  "book": "jiutangshu",
  "title": "舊唐書/卷106",
  "quote": "白晰多鬚長丈夫逼己"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷106",
  "quote": "此形狀類裴寬，寬謀代我故也"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷106",
  "quote": "專得大將之任"
