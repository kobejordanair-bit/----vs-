 {
  "book": "jiutangshu",
  "title": "舊唐書/卷106",
  "quote": "每事過慎，條理眾務，增修綱紀，中外遷除，皆有恆度"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷106",
  "quote": "自處臺衡，動循格令"
