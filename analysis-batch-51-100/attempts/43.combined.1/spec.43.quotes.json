 {
  "book": "jiutangshu",
  "title": "舊唐書/卷106",
  "quote": "溺於聲妓，姬侍盈房"
 },
 {
  "book": "jiutangshu",
  "title": "舊唐書/卷106",
  "quote": "自以結怨於人，常憂刺客竊發，重扃復壁，絡板甃石，一夕屢徙，雖家人不之知"
