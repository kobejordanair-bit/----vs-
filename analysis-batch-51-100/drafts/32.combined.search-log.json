    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "恐蒙氏復貴而用事，怨之",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
