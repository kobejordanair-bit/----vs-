    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "自揃其爪以沈於河",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "過可振而諫可覺也",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "凡臣之言，非以求免於咎也，將以諫而死",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "其勢足以倍畔",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "自知必死而守義",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "疑而復請之",
