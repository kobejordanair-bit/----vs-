    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "何乃罪地脈哉",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "自齊事秦昭王，官至上卿",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "攻楚，大破之，殺項燕",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "嘗書獄典文學",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "因家世得為秦將，攻齊，大破之，拜為內史",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷006",
      "quote": "亡秦者胡也",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7006"
    },
    {
      "book": "shiji",
      "title": "史記/卷006",
      "quote": "始皇乃使將軍蒙恬發兵三十萬人北擊胡，略取河南地",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7006"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "暴師於外十餘年，居上郡。是時蒙恬威振匈奴",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "位至上卿，出則參乘，入則御前",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "將三十萬眾北逐戎狄，收河南",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷006",
      "quote": "自榆中并河以東，屬之陰山，以為三十四縣，城河上為塞",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7006"
    },
    {
      "book": "shiji",
      "title": "史記/卷006",
      "quote": "渡河取高闕、陽山、北假中，筑亭障以逐戎人",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7006"
    },
    {
      "book": "shiji",
      "title": "史記/卷006",
      "quote": "徙謫，實之初縣",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7006"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "筑長城，因地形，用制險塞，起臨洮，至遼東，延袤萬餘里",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "通道，自九原抵甘泉，塹山堙谷，千八百里",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "因地形，用制險塞",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "暴師於外十餘年",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷087",
      "quote": "以兵屬蒙恬，與喪會咸陽而葬",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7087"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "塹山堙谷，通直道，固輕百姓力矣",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "天下之心未定，痍傷者未瘳",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "不以此時彊諫，振百姓之急，養老存孤，務修眾庶之和，而阿意興功",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "蒙恬疑而復請之",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "屬吏，更置",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "毅不敢阿法，當高罪死，除其宦籍",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7088"
    },
    {
      "book": "shiji",
      "title": "史記/卷088",
      "quote": "已聞扶蘇死，即欲釋蒙恬",
