      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7338"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "抗章至七八",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "絶口不論事",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "讀之感泣，欲嘿不忍",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷314",
      "quote": "是使人不得言爾。若欲媚公以為容悅，何如少年合安石以速富貴哉",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7314"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "平民舉錢出息，尚能蠶食下戸，況縣官督責之威乎",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "四患未除，吾死不瞑目矣",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "欲以身徇社稷，躬親庶務，不舍晝夜",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "誠心自然，天下敬信",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷314",
      "quote": "去其太甚者可也",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7314"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "先帝之法，其善者",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "安石、惠卿所建，爲天下害者",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "乃在十年之外",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "他日有以父子義間上，則禍作矣",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "天若祚宗社，必無此事",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "拜其妻如母，撫其子如昆弟",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "忽得語澀疾，疑且死，豫作遺表置臥內",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "賢于荀悅《漢紀》",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "爲人後者爲之子，不得顧私親",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "敝則修之，非大壞不更造",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "改之當如救焚拯溺",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
    },
    {
      "book": "songshi",
      "title": "宋史/卷336",
      "quote": "未嘗有不可對人言者",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%AE%8B%E5%8F%B2%2F%E5%8D%B7336"
