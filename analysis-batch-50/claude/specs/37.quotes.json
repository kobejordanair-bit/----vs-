[
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "奉主上以從民望"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "有子八人，號曰八龍"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "待彧以上賔之禮"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "度紹終不能成大事"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "吾之子房也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "兖州諸城皆應布矣"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "即勒兵設備，馳召東郡太守夏侯惇"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "貢與邈等，分非素結也，今來速，計必未定；及其未定説之，縱不爲用，可使中立，若先疑之，彼將怒而成計"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "見彧無懼意"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "昔髙祖保關中，光武據河内，皆深根固本以制天下"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "是無兖州也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "夫事固有棄此取彼者，以大易小可也，以安易危可也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "今三者莫利"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "奉主上以從民望，大順也；秉至公以服雄傑，大略也；扶弘義以致英俊，大德也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "常居中持重，太祖雖征伐在外，軍國事皆與彧籌焉"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "誰能代卿爲我謀者"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "太祖以彧爲知人，諸所進達皆稱職"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "唯嚴象爲楊州，韋康爲涼州，後敗亡"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "紹貌外寬而内忌，任人而疑其心，公明達不拘，唯才所宜，此度勝也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "公以十分居一之衆，畫地而守之，扼其喉而不得進，已半年矣。情見勢竭，必將有變，此用奇之時，不可失也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "復古置九州"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "天下大定，乃議古制，此社稷長久之利也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "本興義兵以匡朝寧國，秉忠貞之誠，守退讓之實；君子愛人以德，不宜如此"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "由是心不能平"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "以憂薨，時年五十"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "明年，太祖遂爲魏公矣"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "太祖饋彧食，發之乃空器也，於是飲藥而卒"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "荀彧淸秀通雅，有王佐之風，然機鑒先識，未能充其志也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "君臣易位，實彧之由"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "劉宗延二紀之祚"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "亡身殉節，以申素情"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "潁川，四戰之地也，天下有變，常爲兵衝，宜亟去之"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "獨將宗族至冀州"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "皆謙冲節儉，祿賜散之宗族知舊，家無餘財"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "夫明君師臣，其次友之"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "古師友之義"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "臨薨，皆焚毀之，故奇策密謀不得盡聞也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "以吾儕之言而厚誣君子者矣"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "督將大吏多與邈、宮通謀"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "卒全三城，以待太祖"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "此用奇之時，不可失也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "機鑒先識，未能充其志"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "常居中持重"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "軍國事皆與彧籌焉"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "諸所進達皆稱職"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "忠正密謀，撫寧内外，文若是也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "祿賜散之宗族知舊，家無餘財"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "昔髙祖保關中，光武據河内"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "君子愛人以德"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "知邈爲亂，即勒兵設備"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "情見勢竭，必將有變"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "匡天下之素志"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "本興義兵以匡朝寧國"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "社稷長久之利"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "君子愛人以德，不宜如此"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "機鑒先識，未能充其志也"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "納周襄王而諸侯景從"
 },
 {
  "book": "sanguozhi",
  "title": "三國志/卷10",
  "quote": "豈不知魏武之志氣，非衰漢之貞臣哉"
