[
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "言南遷者，可斬也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "不殺于謙，此舉為無名"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "手書謙名授吏部"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "前後在任十九年"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "極諫，不聽"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "京師大震，眾莫知所為"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "所餘疲卒不及十萬，人心震恐，上下無固志"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "他日救時宰相也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "先菽秫，次黍麥，次稻。俟秋成償官，而免其老疾及貧不能償者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "預備糧有未足，不聽離任"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "盡奪鎮將私墾田為官屯，以資邊用"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "山西、河南吏民伏闕上書，請留謙者以千數"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "言南遷者，可斬也。京師天下根本，一動則大事去矣，獨不見宋南渡事乎"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "排眾直前掖王止"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "順等罪當死，勿論"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "袍袖為之盡裂"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "國家正賴公耳。今日雖百王直何能為"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "國無主，太子方幼"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "臣等誠憂國家，非為私計"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "斂兵堅壁老之"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "奈何示弱，使敵益輕我"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "率師二十二萬，列陣九門外"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "悉閉諸城門，身自督戰"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "臨陣將不顧軍先退者，斬其將。軍不顧將先退者，後隊斬前隊"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "知終弗可得志，又聞勤王師且至"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "分十營團操"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "理當速奉迎"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "諸臣皆辭，謙獨辭至再"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "謀迎立襄王子"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "亨等意耳，辯何益"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "于謙實有功"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "視諸選耎大臣、勳舊貴戚，意頗輕之，憤者益眾"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "于謙被遇景泰朝，死無餘貲，汝言抑何多也"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "當國家之多難，保社稷以無虞"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "此一腔熱血，竟灑何地"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "國家多難，臣子何敢自安"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "四郊多壘，卿大夫之恥也，敢邀功賞哉"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "我有失，望君面規我，何至爾邪"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "具實對，無所隱，不避嫌怨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "諸不任職者皆怨"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "所餘疲卒不及十萬"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "後隊斬前隊"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "京師天下根本，一動則大事去矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "所論奏無不從者"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "意頗輕之，憤者益眾"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "言南遷者，可斬也。京師天下根本，一動則大事去矣"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "和不足恃，明矣。況我與彼不共戴天，理固不可和"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "至軍旅之事，臣身當之，不効則治臣罪"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "毅然以社稷安危為己任"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "自值也先之變，誓不與賊俱生。嘗留宿直廬，不還私第"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "日夜分國憂，不問家產"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "身往討之，以復前仇"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "不聞舉一幽隱，拔一行伍微賤"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "親幸萬歲山，伐竹取瀝以賜"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "此舉為無名"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "獨不見宋南渡事乎"
 },
 {
  "book": "mingshi",
  "title": "明史/卷170",
  "quote": "而也先隨入寇"
 }
]