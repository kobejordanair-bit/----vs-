 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "潛送出汝陰"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "諸君若疑惑，慶之請獨取之"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "我等才有七千，虜衆三十餘萬"
