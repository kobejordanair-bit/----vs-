[
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "名師大將莫自牢，千兵萬馬避白袍"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "射不穿札，馬非所便"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "幼而隨從高祖"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "每從夜達旦不輟，等輩皆倦寐，惟慶之不寢，聞呼卽至，甚見親賞"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "散財聚士，常思效用"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "本非將種，又非豪家"
 },
 {
  "book": "nanshi",
  "title": "南史/卷61",
  "quote": "梁世寒門達者唯慶之與俞藥"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "以本朝大亂，自拔來降，求立爲魏主"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "以逸待勞，不如勿擊"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "魏人遠來，皆已疲倦"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "及其未集，須挫其氣"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "並無鬭心，皆謀退縮，豈是欲立功名，直聚爲抄暴耳"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "銜枚夜出，陷其四壘"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "鼓噪而攻之，遂大奔潰"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "降城中男女三萬餘口"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "自旦至申，陷其三壘"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "浮水築壘，攻陷其城，生擒暉業"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "我等才有七千，虜衆三十餘萬，今日之事，義不圖存。吾以虜騎不可爭力平原，及未盡至前，須平其城壘"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "率騎三千背城逆戰，大破之"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "自發銍縣至於洛陽，十四旬平三十二城，四十七戰，所向無前"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "吾至此以來，屠城略地，實爲不少；君等殺人父兄，略人子女，又爲無算"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "陳慶之兵不出數千，已自難制；今增其衆，寧肯復爲用乎"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "詔衆軍皆停界首"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "顥據洛陽六十五日，凡所得城，一時反叛"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "三日中十有一戰"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "落鬚髮爲沙門"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "卿可以策制之，不宜決戰"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "罷義陽鎮兵，停水陸轉運，江湖諸州並得休息。開田六千頃，二年之後，倉廩充實"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "開倉賑給，多所全濟"
 },
 {
  "book": "nanshi",
  "title": "南史/卷61",
  "quote": "性祗慎，每奉詔敕，必洗沐拜受"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "衣不紈綺，不好絲竹"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "射不穿札，馬非所便，而善撫軍士，能得其死力"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "屠顥據洛，則千載一時"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "慶之不敢復言"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "十四旬平三十二城，四十七戰，所向無前"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "一鼓悉使登城"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "置兵死地，乃可求生"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "虜騎不可爭力平原"
