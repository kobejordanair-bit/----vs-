 {
  "book": "liangshu",
  "title": "梁書/卷32",
  "quote": "君等殺人父兄，略人子女，又爲無算。天穆之衆，並是仇讎"
 },
 {
  "book": "liangshu",
  "title": "梁書/卷32",
