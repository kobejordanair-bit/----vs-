[
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "不學亡術，闇於大理"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "欲自發舉，不忍"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "出入禁闥二十餘年，小心謹慎，未甞有過，甚見親信"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "受遺詔輔少主"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "使黃門畫者畫周公負成王朝諸侯以賜光"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "君未諭前畫意邪？立少子，君行周公之事"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "臣不如金日磾"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "臣外國人，不如光"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "政事壹決於光"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "臣頭可得，璽不可得也"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "衆庶莫不多光"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "專權自恣，疑有非常"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "何以得知之"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "且將軍爲非，不須校尉"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "光盡誅桀、安、弘羊、外人宗族"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "羣臣後應者，臣請劔斬之"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "唯大將軍令"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "受璽以來二十七日，使者旁午，持節詔諸官署徵發，凡千一百二十七事"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "天子有爭臣七人，雖無道不失天下"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "皇太后詔廢，安得天子"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "當斷不斷，反受其亂"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "百姓充實，四夷賔服"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "具以實語光"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "大驚，欲自發舉，不忍，猶與"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "因署衍勿論"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "陰妻邪謀，立女爲后，湛溺盈溢之欲，以增顛覆之禍"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "悉易以所親信許、史子弟代之"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "於是始有邪謀矣"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "與霍氏相連坐誅滅者數千家"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "威震主者不畜，霍氏之禍萌於驂乘"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "若有芒刺在背"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "每出入下殿門，止進有常處，郎僕射竊識視之，不失尺寸"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "爲人沈靜詳審"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "臣寧負王，不敢負社稷"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "但事馮子都、王子方等"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "盡誅桀、安、弘羊、外人宗族"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "將羽林騎收縛二百餘人"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "出則奉車，入侍左右"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "擁昭立宣，光爲師保"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "雖周公、阿衡，何以加此"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "諸事皆先關白光，然後奏御天子"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "黨親連體，根據於朝廷"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "連坐誅滅者數千家"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "今欲如是，於古甞有此否"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "昌邑王行昬亂，恐危社稷，如何"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "九卿責光是也"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "止畫室中不入"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "免冠頓首謝"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "欲自發舉，不忍，猶與"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "周公負成王"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "行周公之事"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "躬秉誼，率三公九卿大夫定萬世冊以安社稷"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "在人之右，衆必害之"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "奉兄票騎將軍去病祀"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "臣長不復左右"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "謙讓不受，諸事皆先關白光"
 },
 {
  "book": "hanshu",
  "title": "漢書/卷068",
  "quote": "臨大節而不可奪"
 }
]