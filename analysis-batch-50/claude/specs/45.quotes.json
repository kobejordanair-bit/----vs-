[
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "下軍機處擬旨，親禦硃筆批發"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "命設軍機房隆宗門內，以怡親王允祥、廷玉及大學士蔣廷錫領其事。嗣改稱辦理軍機處"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "諸臣陳奏，常事用疏，自通政司上，下內閣擬旨；要事用摺，自奏事處上，下軍機處擬旨，親禦硃筆批發"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "自是內閣權移於軍機處，大學士必充軍機大臣，始得預政事"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "軍機處初設，職制皆廷玉所定"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "察明考驗錄用"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "器量純全，抒誠供職，命他日配享太廟"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "糾眾倡邪教"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "戮七人、戍三十五人而讞定"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "豈有從祀元臣歸田終老"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "亮受任軍旅，臣幸得優游太平，未可同日而語"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "自是不敢言去"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "免冠叩首，乞上一言為券"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "罷廷玉配享"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "命盡繳歷年頒賜諸物"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "命仍遵世宗遺詔，配享太廟"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "在政地久，兩家子弟賓客，漸且競權勢、角門戶，高宗燭幾摧萌，不使成朋黨之禍，非二臣之幸歟"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "周敏勤慎，尤為上所倚"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "堅辭，乃改二甲一名"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "無足當此者，撰議以為不可行"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "內閣權移於軍機處"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "入內廷須扶掖"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "無足當此者"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "乞上一言為券"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "庶政修舉，宇內乂安"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "終清世，漢大臣配享太廟，惟廷玉一人而已"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "命總理事務"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "子弟賓客，漸且競權勢、角門戶"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "宋、明配享諸臣亦有乞休得請者"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "七十懸車，古今通義"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "命舉所諭宣告朝列"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "往往刪截，但用數語"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "惶懼，疏請罷配享治罪"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "恐身後不獲更蒙大典"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "朕以廷玉之戒為戒，且為廷玉惜之"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "發帑金萬為英建祠"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "盡繳歷年頒賜諸物"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "以明劉基乞休後仍配享為例"
 },
 {
  "book": "qingshigao",
  "title": "清史稿/卷288",
  "quote": "親禦硃筆批發"
 }
