[
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "運籌策帷帳中，決勝千里外，子房功也"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "多病，未嘗特將也"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "從赤松子游"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "悉以家財求客刺秦王，為韓報仇"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "更名姓，亡匿下邳"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "往來為游兵"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "間行歸漢王"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "意欲留居之"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "夫秦為無道，故沛公得至此。夫為天下除殘賊，宜縞素為資。今始入秦，即安其樂，此所謂『助桀為虐』"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "臣請藉前箸為大王籌之"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "今陛下能制項籍之死命乎"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "徒欲日夜望咫尺之地"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "天下游士各歸事其主"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "陛下與誰取天下乎"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "豎儒，幾敗而公事"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "九江王黥布，楚梟將，與項王有郄；彭越與齊王田榮反梁地：此兩人可急使。而漢王之將獨韓信可屬大事，當一面"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "然卒破楚者，此三人力也"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "左殽函，右隴蜀，沃野千里"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "此所謂金城千里，天府之國也"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "即日駕，西都關中"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "不能盡封，恐又見疑平生過失及誅"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "雍齒尚為侯，我屬無患矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "此難以口舌爭也"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "羽翼已成，難動矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "竟不易太子者，留侯本招此四人之力也"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "今以三寸舌為帝者師，封萬戶，位列侯，此布衣之極，於良足矣。願棄人間事，欲從赤松子游耳"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "學辟穀，道引輕身"
 },
 {
  "book": "zizhitongjian",
  "title": "資治通鑑/卷011",
  "quote": "足以知神仙之為虛詭矣"
 },
 {
  "book": "zizhitongjian",
  "title": "資治通鑑/卷011",
  "quote": "淮陰誅夷，蕭何繫獄"
 },
 {
  "book": "zizhitongjian",
  "title": "資治通鑑/卷011",
  "quote": "托於神仙，遺棄人間，等功名於外物"
 },
 {
  "book": "zizhitongjian",
  "title": "資治通鑑/卷011",
  "quote": "所謂明哲保身者，子房有焉"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "鄂然，欲毆之。為其老，彊忍，下取履"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "臣為韓王送沛公，今事有急，亡去不義"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "善之，常用其策"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "沛公殆天授"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "自擇齊三萬戶"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "臣願封留足矣，不敢當三萬戶"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "計魁梧奇偉"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "狀貌如婦人好女"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "以貌取人，失之子羽"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "與韓王將千餘人西略韓地，得數城"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "下韓十餘城，擊破楊熊軍"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "多病，未嘗特將也，常為畫策"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "得力士，為鐵椎重百二十斤"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "病，自彊起，至曲郵"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "金城千里，天府之國"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "德留侯，乃彊食之"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "沛公誠欲背項羽邪"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "沛公自度能卻項羽乎"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "具以語沛公"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "恐又見疑平生過失及誅"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "悉以家財求客刺秦王，為韓報仇，以大父、父五世相韓故"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "為韓報讐彊秦，天下振動。今以三寸舌為帝者師"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "此布衣之極，於良足矣"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "骨肉之間，雖臣等百餘人何益"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "愈欲易太子"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "諫，不聽，因疾不視事"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "此天以臣授陛下"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "并葬黃石冢"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "彊臥而傅太子"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "忠言逆耳利於行"
 },
 {
  "book": "shiji",
  "title": "史記/卷055",
  "quote": "因疾不視事"
 }
]