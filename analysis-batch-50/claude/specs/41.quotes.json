[
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "小兒輩遂已破賊"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "不覺屐齒之折"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "與王羲之及高陽許詢、桑門支遁遊處"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "始有仕進志"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "大陳兵衛，將移晉室"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "欲於坐害之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "梁益不守，樊鄧陷沒"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "皆比之王導，謂文雅過之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "流汗沾衣，倒執手版"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "安聞諸侯有道，守在四鄰，明公何須壁後置人邪"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "正自不能不爾耳"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "遂笑語移日"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "晉祚存亡，在此一行"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "見，輒改之，由是曆旬不就"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "安違眾舉親，明也。玄必不負舉，才也"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "精銳八千涉渡肥水"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "以總統功，進拜太保"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "夷然無懼色"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "至夜乃還，指授將帥，各當其任"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "父子皆著大勳，恐為朝廷所疑，又懼桓氏失職"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "既以三桓據三州，彼此無恐，各得所任"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "肴饌亦屢費百金，世頗以此譏焉"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "奸諂頗相扇構"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "出鎮廣陵之步丘，築壘曰新城以避之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "諸人並懼，安吟嘯自若"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "如此將何歸邪"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "了無喜色，棋如故"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "虛談廢務，浮文妨要"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "秦任商鞅，二世而亡，豈清言致患邪"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "常疑劉牢之既不可獨任，又知王味之不宜專城"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "由是識者服其知人"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "雖受朝寄，然東山之志始末不渝，每形於言色"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "征討大都督"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "指授將帥，各當其任"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "應機征討，所在克捷"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "出則漁弋山水，入則言詠屬文"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "明公何須壁後置人邪"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "三桓據三州"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "盡忠匡翼，終能輯穆"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "德政既行，文武用命，不存小察，弘以大綱"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "謂文雅過之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "彼此無恐，各得所任"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "少有盛名，時多愛慕"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "京師士庶競市，價增數倍"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "手掩鼻以斅之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "行不由西州路"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "世頗以此譏焉"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "至夜乃還，指授將帥"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "東山之志始末不渝，每形於言色"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "造泛海之裝，欲須經略粗定，自江道還東"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "從亡叔臣安退身東山，以道養壽"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "十年不聽音樂"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "患之，而不欲傷其意，因戲賭取，即焚之"
 },
 {
  "book": "jinshu",
  "title": "晉書/卷079",
  "quote": "自以本志不遂，深自慨失"
 }
