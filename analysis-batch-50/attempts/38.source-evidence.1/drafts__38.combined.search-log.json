    },
    {
      "book": "shiji",
      "title": "史記/卷055",
      "quote": "不能盡封，恐又見疑平生過失及誅",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7055"
