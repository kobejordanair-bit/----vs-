    },
    {
      "book": "qingshigao",
      "title": "清史稿/卷288",
      "quote": "器量純全，抒誠供職，命他日配享太廟",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7288"
    },
    {
      "book": "qingshigao",
      "title": "清史稿/卷288",
      "quote": "糾眾倡邪教",
