    },
    {
      "book": "qingshigao",
      "title": "清史稿/卷288",
      "quote": "命設軍機房隆宗門內，以怡親王允祥、廷玉及大學士蔣廷錫領其事。嗣改稱辦理軍機處",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7288"
    },
    {
      "book": "qingshigao",
      "title": "清史稿/卷288",
      "quote": "諸臣陳奏，常事用疏，自通政司上，下內閣擬旨；要事用摺，自奏事處上，下軍機處擬旨，親禦硃筆批發",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7288"
    },
    {
      "book": "qingshigao",
      "title": "清史稿/卷288",
      "quote": "自是內閣權移於軍機處，大學士必充軍機大臣，始得預政事",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7288"
    },
    {
      "book": "qingshigao",
      "title": "清史稿/卷288",
      "quote": "軍機處初設，職制皆廷玉所定",
      "sourceUrl": "https://zh.wikisource.org/wiki/%E6%B8%85%E5%8F%B2%E7%A8%BF%2F%E5%8D%B7288"
    },
    {
      "book": "qingshigao",
      "title": "清史稿/卷288",
      "quote": "察明考驗錄用",
