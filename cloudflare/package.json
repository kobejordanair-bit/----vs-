{
  "name": "dynasty-cloudflare",
  "version": "16.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "test": "node --test tests/*.test.mjs scripts/build-assets.test.mjs",
    "dev": "wrangler dev",
    "dev:local": "node scripts/dev-local.mjs",
    "deploy": "npm run build:assets && wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
