02T11:14:45.150Z","upstreamTextQuality":null,"upstreamTextQualityMeaning":"Wikisource platform quality marker; not a percentage of text transcribed","textCompleteness":"not-independently-collated","extractionNotes":[],"expandedTransclusionTitles":[],"transclusionIssues":[],"transclusions":[],"textPath":"/static/data/history/web/releases/b66c5a60a41e2334/documents/e2f40ec58854dcf2d3fa.json","wikitextPath":"/static/data/history/web/releases/b66c5a60a41e2334/wikitext/e2f40ec58854dcf2d3fa.json","relatedDocumentIds":[]},{"id":"document:mingshi-63e515243e9b64dc","bookId":"book:mingshi","requestedTitle":"明史/卷94","title":"明史/卷94","sourceUrl":"https://zh.wikisource.org/wiki/%E6%98%8E%E5%8F%B2%2F%E5%8D%B794","revisionUrl":"https://zh.wikisource.org/w/index.php?oldid=2611723","historyUrl":"https://zh.wikisource.org/wiki/%E6%98%8E%E5%8F%B2%2F%E5%8D%B794?action=history","revisionId":2611723,"revisionTimestamp":"2025-11-04T06:58:33Z","retrievedAt":"2026-10-02T10:59:07.236Z","sha256":"9530787855588af56b1fad5762334574bfc42c90eab8393c50dc33b6819a6f5e","textSha256":"9214afbf1632de5ae6565d8bed406ba0b85ffa9d4061341d9e4d3bfff386929d","expandedWikitextSha256":"9530787855588af56b1fad5762334574bfc42c90eab8393c50dc33b6819a6f5e","characters":12427,"contentPath":"/static/data/history/archive-books/mingshi.json","status":"downloaded","acquisitionStatus":"downloaded","reuse":"Ancient underlying text; Wikisource transcription attribution and CC BY-SA 4.0 for applicable contributions","extraction":"wikitext-conservative-v2.1.0","normalizedAt":"2026-10-02T11:14:45.163Z","upstreamTextQuality":null,"upstreamTextQualityMeaning":"Wikisource platform quality marker; not a percentage of text transcribed","textCompleteness":"not-independently-collated","extractionNotes":[],"expandedTransclusionTitles":[],"transclusionIssues":[],"transclusions":[],"textPath":"/static/data/history/web/releases/b66c5a60a41e2334/documents/b196d1c9119cd53c7470.json","wikitextPath":"/static/data/history/web/releases/b66c5a60a4