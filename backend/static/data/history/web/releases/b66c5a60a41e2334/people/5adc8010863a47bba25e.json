ds":[],"claimIds":[],"matches":[{"documentId":"document:weishu-db3c5b89b669ac85","query":"曹昂","count":1,"offset":5854,"excerpt":"門郎、散騎常侍。出帝世，國子祭酒。不營家產，至以餒卒於鄴，時人傷歎之。\n\n又齊郡曹昂，有學識，舉秀才。永安中，太學博士、兼尚書郎。而常徒步上省，以示清貧。忽遇盜，大失綾縑，時人鄙其矯詐。\n\n鹿悆\n\n鹿悆，字永吉，濟陰人。父生，在良吏傳。悆好兵書","matchType":"name-occurrence"},{"documentId":"document:beishi-32a6bad67f39eab7","query":"曹昂","count":1,"offset":10440,"excerpt":"州刺史。元興世寒，因元叉之勢，托其交道，相用為州主簿，論者以為非倫。\n\n時有濟郡曹昂，有學識，舉秀才。永安中，除太學博士，兼尚書郎。常徒步上省，以示清貧，忽遇盜，大失綾縑，時人鄙其矯詐。\n\n論曰：孫紹關左之士，又能指論時務。張普惠明達典故，強直","matchType":"name-occurrence"}],"matchCount":2,"gaps":["身份連結尚未完成編輯核對；同名、異名或同時代關係可能有誤配。","原人物分析及能力數值尚未逐句核對。","來源中的年代、關係與評價仍需逐條轉成有出處的主張。"],"notes":["姓名／重新導向命中，人物身份與每條書目尚須逐項核對。","姓名、分類、時代及稱號保留原庫資料，不自動視為史實。"],"version":"b66c5a60a41e2334","matchedDocuments":[{"id":"document:weishu-db3c5b89b669ac85","bookId":"book:weishu","requestedTitle":"魏書/卷79","title":"魏書/卷79","sourceUrl":"https://zh.wikisource.org/wiki/%E9%AD%8F%E6%9B%B8%2F%E5%8D%B779","revisionUrl":"https://zh.wikisource.org/w/index.php?oldid=2294159","historyUrl":"https://zh.wikisource.org/wiki/%E9%AD%8F%E6%9B%B8%2F%E5%8D%B779?action=history","revisionId":2294159,"revisionTimestamp":"2023-06-10T01:54:22Z","retrievedAt":"2026-10-02T10:48:02.373Z","sha256":"a339addfea08b0beb5a85639f946dd50d98e89be2c589df887ffd4079a931531","textSha256":"6c28fc0d61853da4243bcd2cc5bb3895c965261cacdac369af3c78362a99dff7","expandedWikitextSha256":"a339addfea08b0beb5a85639f946dd50d98e89be2c589df887ffd4079a931531","characters":9178,"contentPath":"/static/data/history/archive-books/weishu.json","status":"downloaded","acquisitionStatus":"downloaded","reuse":"Ancient underlying text; Wikisource transcription attribution and CC BY-SA 4.0 for applicable contributions","extraction":"wikitext-conservative-v2.1.0","normalizedAt":"2026-10-02T11:14:37.544Z","upstreamTextQuality":null,"upstreamTextQualityMeaning":"Wikisource platform quality marker; not a percentage of text transcribed","textCompleteness":"not-independently-collated","extraction